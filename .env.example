# URL da API real. Vazio usa a mesma origem da aplicação.
NEXT_PUBLIC_API_BASE_URL=

# Use "enabled" para iniciar o MSW no navegador durante o desenvolvimento.
NEXT_PUBLIC_API_MOCKING=enabled

# Latência padrão dos handlers em milissegundos.
NEXT_PUBLIC_API_MOCK_DELAY_MS=150

# Entradas dos remotes consumidas pelo shell React durante build/deploy.
INSTITUTIONAL_REMOTE_URL=http://127.0.0.1:8101/remoteEntry.js
DASHBOARD_REMOTE_URL=http://127.0.0.1:8102/remoteEntry.js

# URL pública do shell usada pelo dashboard quando aberto standalone.
SHELL_PUBLIC_URL=http://127.0.0.1:4200

# Firebase mobile. O Expo também lê apps/mobile/.env.local; todas as variáveis
# EXPO_PUBLIC_* ficam visíveis no bundle e jamais devem conter segredos.
# O padrão seguro é o Emulator Suite. Somente o valor explícito "false" usa o
# Firebase real. Em dispositivo físico, informe o IP LAN no host do emulador.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
