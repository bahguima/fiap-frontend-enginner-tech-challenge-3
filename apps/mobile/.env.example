# Copie para .env.local. Variáveis EXPO_PUBLIC_* são incorporadas ao aplicativo
# e devem ser tratadas como públicas. Nunca coloque segredos neste arquivo.
# Sem configuração real, o app usa exclusivamente o projeto demo local.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true

# Deixe vazio para localhost no web/simulador iOS e 10.0.2.2 no emulador Android.
# Para dispositivo fisico, use o IP LAN da maquina, por exemplo 192.168.1.10.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# Preencha com o objeto de configuração do app Web do Firebase Console somente
# quando EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false. Estes identificadores de
# cliente não são credenciais administrativas, mas continuam públicos no bundle.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
